# The dev shell lives in dev/flake.nix, apart from the app flake's lock.
# devenv needs impure eval to locate the working directory, hence --no-pure-eval.
# A jj workspace under .worktrees/ has no .git, so evaluate the main checkout's flake instead.
if [[ "$PWD" == */.worktrees/* ]]; then
  use flake "${PWD%%/.worktrees/*}/dev" --no-pure-eval
else
  use flake ./dev --no-pure-eval
fi
export DEVENV_IN_DIRENV_SHELL=true
